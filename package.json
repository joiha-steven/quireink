{
  "name": "quireink",
  "version": "2.2.5",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run build:assets && bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run build:assets && bun run build:admin",
    "build:assets": "bun scripts/build-assets.ts",
    "build:admin": "bun scripts/build-admin.ts",
    "test": "bun run build:assets && bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/assets/js && tsc --noEmit -p src/admin",
    "check:filesize": "bun scripts/checks/file-size.ts",
    "check:all": "bun run build:assets && bun run build:admin && bun run typecheck && bun run check:filesize && bun run check:css && bun run check:nul && bun run check:routes && bun run check:type && bun run check:admin-kit && bun run check:bundle && bun run check:contract && bun run check:docs && bun test",
    "check:css": "bun scripts/checks/css-literal.ts",
    "check:nul": "bun scripts/checks/no-nul.ts",
    "check:routes": "bun scripts/checks/routes-guarded.ts",
    "check:contract": "bun scripts/checks/appearance-contract.ts",
    "check:docs": "bun scripts/checks/docs.ts",
    "check:type": "bun scripts/checks/type-roles.ts",
    "check:admin-kit": "bun scripts/checks/admin-kit.ts",
    "check:bundle": "bun scripts/checks/admin-bundle.ts",
    "user": "bun scripts/user.ts",
    "shot": "bun scripts/shot.ts",
    "drive": "bun scripts/drive.ts",
    "tour": "scripts/ops/tour.sh",
    "restore-check": "bun scripts/restore-check.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/cli": "^4",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.1",
    "marked": "18.0.9",
    "nodemailer": "^9.0.5",
    "qrcode-generator": "^2.0.4",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "shiki": "4.4.3",
    "temml": "^0.13.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  }
}
