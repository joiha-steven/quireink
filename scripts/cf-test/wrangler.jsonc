// The contract worker for `bun run test:cf` (scripts/test-cf.ts). Local only; never deployed.
{
  "name": "quireink-contracts",
  "main": "../../dist/cf-test/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "base_dir": "../../dist/cf-test",
  "find_additional_modules": true,
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  // The fonts, icons and Shiki's grammars that `scripts/build-worker.ts` writes beside the worker.
  "assets": { "directory": "../../dist/cf-test-public", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "quireink-contracts" }],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "Probe" }] },
  // The archive store's cases (kept archives, the parts of an incoming one) need a bucket; local only.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "quireink-contracts" }],
  // The image case holds `cf/image.ts` to the binding itself; `wrangler dev --local` serves it offline.
  "images": { "binding": "IMAGES" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Probe"] }]
}
