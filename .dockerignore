# What the image build is allowed to see. The Dockerfile copies named paths rather than
# `COPY . .`, so this is a second fence rather than the only one, and it is what keeps the
# build context small.

.git
.github
golden
docs

node_modules
**/node_modules
**/dist
.next

# Runtime data. Never bake an instance into an image.
data
uploads
data-dev-uploads
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.docker.example

# Local scratch, evidence, and the deploy's commit stamp (the image is not a deploy).
build-sha
.tmp
coverage
*.tsbuildinfo
