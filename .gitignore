# Quire Ink runs two trees out of one repository: the live Bun/Hono/SQLite implementation at
# the root, and the frozen Next.js one in `v1/`. Patterns are deliberately UNANCHORED so a
# single rule covers both; the anchored `/node_modules` form used before the reshuffle
# stopped matching the moment the Next tree moved down a level.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output — the compiled binary, the bundled admin and island JS, Next's cache
dist/
.next/
out/
build/

# runtime data. SQLite databases and everything a reader or the owner uploaded: this is
# the instance, not the product, and none of it belongs in a public repository.
*.db
*.db-wal
*.db-shm
data/
uploads/
data-dev-uploads/

# test and script scratch
.tmp-test-*/
.tmp-drive-data/
.tmp-shots/

# Written by the deploy so the admin can name the running commit. Never committed:
# it would change on every commit and mean nothing in the tree.
build-sha
.tmp-run/
.tmp-binary/
coverage/

# env files. The committed templates carry no secrets and are tracked.
.env*
!.env.docker.example
!v1/.env.example
!v1/.env.docker.example
.deployment-id

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local media-wipe backup artifacts
media-index-backup-*.json

# Local blob-cleanup backups (contain real site content — never commit)
audit/legacy-blob-backup-*/

# Screenshots taken while driving the site with headless Chromium. Evidence, not source.
.shots/
_shots/
