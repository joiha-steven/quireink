# dependencies
node_modules/

# build output: the compiled binary and the bundled admin and island JS
dist/
out/
build/
# ...and the scratch file `bun build --compile` leaves beside them: a 61 MB dotfile that
# nothing cleans up. Untracked and unignored, it made `git status` dirty, and deploy.sh
# refuses a dirty tree -- so running the build could block the next deploy with a message
# about a file the deploy has nothing to do with.
.*.bun-build

# runtime data. SQLite databases and everything a reader or the owner uploaded: this is
# the instance, not the product, and none of it belongs in a public repository.
*.db
*.db-wal
*.db-shm
data/
uploads/
data-dev-uploads/

# ALL scratch lives under one root: test databases, seeded runs, compiled throwaways,
# screenshots taken while driving the site. One rule, one directory, and a tree listing
# that stays readable. Anything written here is regenerated and may be deleted at any time.
.tmp/

# Written by the deploy so the admin can name the running commit. Never committed: it
# would change on every commit and mean nothing in the tree.
build-sha
.deployment-id
coverage/

# env files. The committed template carries no secrets and is tracked.
.env*
!.env.docker.example

# design-sync: staged converter scripts, generated bundle, and machine-local state. All of
# it is rebuilt from `src/` on every run, so a tracked copy is a second answer to the same
# question and it is stale the moment a component changes. These rules were written on the
# `design-sync-admin-ui` branch, where the durable inputs live; main had none of them, so a
# `git add -A` here swept 794 generated files into a public repository on 2026-08-01. They
# are gone again, and this is why.
.ds-sync/
ds-bundle/
ds-bundle-reader/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/generated/

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*
.pnpm-debug.log*
media-index-backup-*.json
