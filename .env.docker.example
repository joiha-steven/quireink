# Copy to `.env` beside docker-compose.yml, then edit. Compose reads it; nothing else does.
#
# DATA_DIR, STORAGE_LOCAL_DIR and PORT are deliberately absent: the compose file sets them
# to the paths its volumes are mounted on and overrides anything written here.
#
# There is no secret to generate. Quire Ink 2.0 creates its own signing secrets on first use
# and keeps them in the database (src/auth/secret.ts), so there is nothing here to leave
# unset by accident.

# The public URL, with scheme and no trailing slash. Not optional in practice: leave it
# empty and feeds, OG images and preview links are built from whatever hostname the proxy
# passed through, which behind Docker is an internal one.
SITE_URL=https://example.com

# --- optional ----------------------------------------------------------------------------
# Everything else (SMTP, Turnstile, Cloudflare, the site's name and language) is entered in
# the admin and stored in the database, not here.

# Protects /api/cron, the scheduled-publishing sweep. Set it if you expose that path.
# CRON_SECRET=

# Signs MCP OAuth codes. Without it the server uses its own generated secret, which is the
# recommended setting: it exists only for pinning the value across two hosts.
# MCP_OAUTH_SECRET=

# IANA zone the analytics day boundary uses. Defaults to UTC.
# ANALYTICS_TZ=Asia/Ho_Chi_Minh
